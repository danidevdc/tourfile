rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- User Profiles ---
    // Users can read their own profile. Admins can read all.
    // Users can create their own profile.
    // Users can update their own profile (e.g., lastSignInTime, activeSessionId). Admins can update any.
    // Admins can delete any user profile.
    match /userProfiles/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true);
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true);
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- App Configuration (Special Roles) ---
    // Anyone can read to check permissions. Only admins can write.
    match /appConfig/specialRoles {
        allow read: if true;
        allow write: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Generated Reports & Flight Search Stats ---
    // Logged-in users can create. Only admins can read all for metrics.
    match /{collectionName}/{docId} where collectionName in ['generatedReports', 'flightSearchStats'] {
      allow read: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
      allow create: if request.auth != null;
      // No updates or deletes from client side for these collections.
      allow update, delete: if false;
    }

    // --- Master Data (Guides, Hotels, Drivers, Activities, Flights, Buses) ---
    // Anyone logged in can read, create, and update.
    // Only admins can delete to protect data integrity.
    function isMasterData() {
      return resource.collection == 'guides' || resource.collection == 'hotels' || resource.collection == 'drivers' || resource.collection == 'activities' || resource.collection == 'flights' || resource.collection == 'buses';
    }
    
    match /{collection}/{docId} where isMasterData() {
       allow read, create, update: if request.auth != null;
       allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Rule Definitions (Petty Cash & Service Orders) ---
    // Only admins can manage these business logic rules.
    function isRuleCollection() {
        return resource.collection == 'expenseRules' || resource.collection == 'serviceOrderRules';
    }

    match /{collection}/{ruleId} where isRuleCollection() {
        allow read, write: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // --- Service Orders ---
    // Users can read/write their own orders. Admins can read/write all.
    match /serviceOrders/{orderId} {
        allow read: if request.auth != null && (resource.data.createdBy == request.auth.token.email || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true);
        allow create: if request.auth != null;
        allow update: if request.auth != null && (resource.data.createdBy == request.auth.token.email || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true);
        // Deletion is a "soft delete" via update, so it's covered by the update rule.
        // No hard deletes from client.
        allow delete: if false;
    }
  }
}
