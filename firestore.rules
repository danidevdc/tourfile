
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuth() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(email) {
      return isAuth() && request.auth.token.email == email;
    }

    // --- User Profiles ---
    // Users can read their own profile.
    // Admins can read any profile.
    // Users can only create their own profile.
    // Users can only update their own profile.
    match /userProfiles/{userId} {
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && request.auth.uid == userId;
      allow delete: if isAdmin(); // Only admins can delete profiles
    }

    // --- Service Orders ---
    // Any authenticated user can read and create orders.
    // Only the owner or an admin can update or delete an order.
    match /serviceOrders/{orderId} {
      allow read, create: if isAuth();
      allow update, delete: if isAuth() && (isOwner(resource.data.createdBy) || isAdmin());
    }
    
    // --- Generated Reports ---
    // Any authenticated user can create a report record.
    // Only admins can read all report records.
    match /generatedReports/{reportId} {
      allow create: if isAuth();
      allow read: if isAdmin();
    }
    
    // --- Flight Search Stats ---
    // Any authenticated user can read and write (increment) stats.
     match /flightSearchStats/{statId} {
      allow read, write: if isAuth();
    }

    // --- Master Data (Guides, Hotels, Drivers, Activities, Flights) ---
    // Any authenticated user can read this data.
    // Only admins can write/delete this data.
    match /{collectionName}/{docId} 
        where collectionName in ['guides', 'hotels', 'drivers', 'activities', 'flights', 'expenseRules'] {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
  }
}
