rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isUserAdmin(userId) {
      return exists(/databases/$(database)/documents/userProfiles/$(userId)) &&
             get(/databases/$(database)/documents/userProfiles/$(userId)).data.isAdmin == true;
    }

    // User Profiles:
    // - Users can only read/write their own profile.
    // - Admins can read all profiles but cannot write to them directly here (writes should happen via backend functions).
    match /userProfiles/{userId} {
      allow read, update, delete: if request.auth.uid == userId || isUserAdmin(request.auth.uid);
      allow create: if request.auth.uid == userId;
    }
    
    // Default deny for listing all user profiles unless you are an admin.
    // The actual enforcement for listing is done via Firestore queries in the secure backend/hook.
    match /userProfiles/{document=**} {
        allow list: if isUserAdmin(request.auth.uid);
    }

    // Generated Reports:
    // - Authenticated users can create (save) new reports.
    // - Only admins can list/read all reports.
    match /generatedReports/{reportId} {
      allow create: if request.auth != null;
      allow read, list: if request.auth != null && isUserAdmin(request.auth.uid);
    }

    // Expense Rules:
    // - Authenticated users can read the rules (needed for the generator).
    // - Only admins can create, update, or delete rules.
    match /expenseRules/{ruleId} {
        allow read: if request.auth != null;
        allow write, delete, create: if request.auth != null && isUserAdmin(request.auth.uid);
    }

    // Master Data (Guides, Hotels, Drivers, Activities)
    // - Any authenticated user can read this data (for comboboxes, etc.).
    // - Only admins can write/delete this data.
    match /{collectionName}/{docId} where collectionName in ['guides', 'hotels', 'drivers', 'activities', 'activityTimeSuggestions'] {
      allow read: if request.auth != null;
      allow write, delete, create: if request.auth != null && isUserAdmin(request.auth.uid);
    }
    
    // API Usage Counters:
    // - Any authenticated user can write to this collection.
    //   The security is in the transaction logic (server-side) which only increments counters.
    match /apiUsageCounters/{docId} {
      allow read, write: if request.auth != null;
    }

    // Default deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
