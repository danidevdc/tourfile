
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /userProfiles/{userId} {
      // Un usuario autenticado puede crear y actualizar su propio perfil.
      allow write: if request.auth != null && request.auth.uid == userId;

      // Un admin puede leer cualquier perfil. Un usuario normal solo puede leer el suyo.
      allow get: if request.auth != null &&
                  (get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true || request.auth.uid == userId);

      // Solo los administradores pueden listar todos los perfiles de usuario.
      allow list: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;

      // Solo un admin puede eliminar perfiles, y no puede eliminarse a sí mismo.
      allow delete: if request.auth != null &&
                     get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true &&
                     request.auth.uid != userId;
    }

    // --- REGLAS PARA LA LÓGICA DE GASTOS ---
    match /expenseRules/{ruleId} {
      // CUALQUIER usuario autenticado puede LEER las reglas (necesario para el generador).
      allow read: if request.auth != null;

      // SOLO un administrador puede crear, actualizar o eliminar las reglas.
      allow write: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
