
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    // These functions make the rules below easier to read and maintain.
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      // Check if the user is authenticated and if their profile has isAdmin set to true.
      return isAuth() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    function isOwner(email) {
      // Check if the authenticated user's email matches the creator's email on a document.
      return isAuth() && request.auth.token.email == email;
    }

    // --- Collections Rules ---

    // Master Data (Guides, Hotels, etc.): Any authenticated user can read. Only admins can write/delete.
    match /{collection}/{docId} where collection in ['guides', 'hotels', 'drivers', 'activities', 'flights'] {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Expense Rules: Only admins can manage these.
    match /expenseRules/{ruleId} {
      allow read, write: if isAdmin();
    }
    
    // Stats & Reports: Any authenticated user can create. Admins can read/delete.
    match /{collection}/{docId} where collection in ['flightSearchStats', 'generatedReports'] {
      allow read: if isAdmin();
      allow create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // --- Service Orders ---
    // Any authenticated user can read/create orders. Only the owner or an admin can update/delete.
    match /serviceOrders/{orderId} {
      allow read, create: if isAuth();
      allow update, delete: if isAuth() && (isOwner(resource.data.createdBy) || isAdmin());
    }

    // --- User Profiles ---
    // Users can create and manage their own profile. Admins can manage any profile.
    match /userProfiles/{userId} {
      allow create: if isAuth() && request.auth.uid == userId;
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin() && request.auth.uid != userId; // Admins can't delete themselves.
    }
  }
}
