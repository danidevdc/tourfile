
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requesting user is an admin.
    // It safely checks if the user's profile document exists before accessing its data.
    function isRequestingUserAdmin() {
      return exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    match /userProfiles/{userId} {
      // A user can create their own profile.
      allow create: if request.auth.uid == userId;
      
      // A user can get their own profile. An admin can get any profile.
      allow get: if request.auth.uid == userId || isRequestingUserAdmin();

      // A user can update their own profile. An admin can update any profile.
      allow update: if request.auth.uid == userId || isRequestingUserAdmin();
      
      // Only an admin can list all user profiles.
      allow list: if isRequestingUserAdmin();
      
      // Only an admin can delete another user's profile.
      allow delete: if isRequestingUserAdmin() && request.auth.uid != userId;
    }

    // Rules for the expense generation logic.
    match /expenseRules/{ruleId} {
      // Any authenticated user can read the rules to generate their reports.
      allow get, list: if request.auth != null;

      // ONLY an admin can create, update, or delete the expense rules.
      allow write: if isRequestingUserAdmin();
    }
  }
}
