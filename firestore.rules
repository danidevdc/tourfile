
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role
    function isAdmin() {
      // Check for the custom claim first (more secure)
      // return request.auth.token.admin == true;
      // As a fallback, check the user's profile document in Firestore
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Default security: Deny all reads/writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles: Users can read/update their own profile. Admins can read any profile.
    match /userProfiles/{userId} {
      allow read, update: if request.auth.uid == userId;
      allow read: if isAdmin();
    }
    
    // Read-only access for master data for any authenticated user
    match /guides/{guideId} {
      allow read: if request.auth != null;
      allow write: if isAdmin(); // Only admins can modify
    }
    match /hotels/{hotelId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    
    // Expense Rules can be read by authenticated users, but only written by admins.
    match /expenseRules/{ruleId} {
        allow read: if request.auth != null;
        allow write: if isAdmin();
    }
    
    // API Usage Counters can be updated by any authenticated user, and read by admins.
    match /apiUsageCounters/{counterId} {
        allow write: if request.auth != null; // Allows creating and updating counters
        allow read: if isAdmin();
    }

    // Generated reports can be created by authenticated users.
    // Only admins can read all reports.
    match /generatedReports/{reportId} {
        allow create: if request.auth != null;
        allow read, list: if isAdmin();
    }
  }
}
