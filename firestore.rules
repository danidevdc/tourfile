
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin.
    // It reads the user's own profile from the userProfiles collection.
    function isUserAdmin(userId) {
      return get(/databases/$(database)/documents/userProfiles/$(userId)).data.isAdmin == true;
    }

    // --- User Profiles ---
    match /userProfiles/{userId} {
      // A user can read and update their own profile.
      // An admin can read any profile.
      allow read, update: if request.auth.uid == userId || isUserAdmin(request.auth.uid);
      
      // A user can create their own profile document (e.g., during registration).
      allow create: if request.auth.uid == userId;

      // Only an admin can delete a user profile (and they can't delete their own).
      allow delete: if isUserAdmin(request.auth.uid) && request.auth.uid != userId;
    }

    // --- Generated Reports ---
    // Any authenticated user can create a report record.
    match /generatedReports/{reportId} {
        allow create: if request.auth != null;
        // Only admins can view the full list of reports.
        allow list, read: if isUserAdmin(request.auth.uid);
    }
    
    // --- Master Data Collections (Guides, Hotels, etc.) ---
    // Any authenticated user can READ the master data lists for the generators.
    // Only ADMINS can WRITE (create, update, delete) to these lists.
    match /{collectionName}/{docId} where collectionName in ['guides', 'hotels', 'drivers', 'activities', 'expenseRules', 'activityTimeSuggestions'] {
      allow read: if request.auth != null;
      allow write: if isUserAdmin(request.auth.uid);
    }
  }
}
