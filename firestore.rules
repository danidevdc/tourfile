rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- User Profiles ---
    // Users can read/update their own profile.
    match /userProfiles/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;

      // Admins can read all profiles for management purposes.
      allow read: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
      
      // Allow any authenticated user to create their own profile document upon registration.
      // The UID must match their own auth UID.
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // --- Admin-Managed Master Data ---
    // Guides, Hotels, Drivers, Activities, and Expense Rules
    // Any authenticated user can READ this data (e.g., for dropdowns).
    // Only admins can CREATE, UPDATE, or DELETE this data.
    match /{collectionName}/{docId} 
        where collectionName in ['guides', 'hotels', 'drivers', 'activities', 'expenseRules', 'activityTimeSuggestions'] {
      
      allow read: if request.auth != null;
      
      allow write: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Report Logging ---
    // Any authenticated user can create a log entry in generatedReports.
    // No one can read/update/delete logs directly through the client for data integrity.
    match /generatedReports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false; // Prevent client-side modification
    }
  }
}
