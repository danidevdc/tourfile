rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- User Profiles ---
    // Users can read and update their own profile.
    // Admins can read any profile, but cannot delete their own profile through a client.
    match /userProfiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      // Deletion of users should be handled by a backend process or admin SDK for security.
      allow delete: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true && request.auth.uid != userId;
    }
    
    // --- Generated Reports Log ---
    // Any authenticated user can create a report log entry. Only admins can read the full list.
    match /generatedReports/{reportId} {
      allow read: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
      allow create: if request.auth != null;
      allow update, delete: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Master Data Collections (Guides, Hotels, etc.) ---
    // Any authenticated user can read master data. Only admins can write/delete.
    function canReadMasterData() {
      return request.auth != null;
    }
    function canWriteMasterData() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    match /guides/{guideId} {
      allow read: if canReadMasterData();
      allow write, delete: if canWriteMasterData();
    }
    
    match /hotels/{hotelId} {
      allow read: if canReadMasterData();
      allow write, delete: if canWriteMasterData();
    }
    
    match /drivers/{driverId} {
      allow read: if canReadMasterData();
      allow write, delete: if canWriteMasterData();
    }
    
    match /activities/{activityId} {
      allow read: if canReadMasterData();
      allow write, delete: if canWriteMasterData();
    }
    
    match /expenseRules/{ruleId} {
      allow read: if canReadMasterData();
      allow write, delete: if canWriteMasterData();
    }

    match /activityTimeSuggestions/{suggestionId} {
        allow read, write: if request.auth != null; // Allow any authenticated user to contribute
    }

    // --- Flight Data ---
    // Only admins should be able to trigger sync (write) and view the data.
    match /dailyFlights/{flightId} {
      allow read, write, delete: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // Fallback rule: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}