rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin
    function isAdmin() {
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // User Profiles: Users can see their own profile, admins can see all.
    // Users can create and update their own profile. Admins can manage all profiles.
    match /userProfiles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Generated Reports: Admins can read all, authenticated users can create their own.
    match /generatedReports/{reportId} {
        allow read: if isAdmin();
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin();
    }

    // Expense Rules, Guides, Hotels, Drivers, Activities: 
    // Authenticated users can read, only admins can write/delete.
    match /{collectionName}/{docId}
      where collectionName in ['expenseRules', 'guides', 'hotels', 'drivers', 'activities', 'activityTimeSuggestions'] {
        allow read: if isAuthenticated();
        allow write, delete: if isAdmin();
    }
    
    // Daily Flights: This is public-facing flight data.
    // Authenticated users can read it. Only admins (or a trusted server process) can write.
    match /dailyFlights/{flightId} {
      allow read: if isAuthenticated();
      allow write, delete: if isAdmin(); // Locked down to admins for now
    }
    
    // Default deny for any other path
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
