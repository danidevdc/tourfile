
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
          && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- User Profiles ---
    // Users can read/update their own profile. Admins can read any profile.
    match /userProfiles/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && isOwner(userId);
      // Create is handled by registration logic. Deletion is restricted.
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // --- Core Data (Guides, Hotels, etc.) ---
    // Any authenticated user can read. Only admins can write/delete.
    match /{collection}/{docId} where collection in ['guides', 'hotels', 'drivers', 'activities', 'expenseRules'] {
      allow read: if isAuthenticated();
      allow write, delete: if isAdmin();
    }

    // --- Generated Reports ---
    // Any authenticated user can create a report record.
    match /generatedReports/{reportId} {
      allow read: if isAdmin(); // Only admins can read all reports
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // --- API Usage Counters ---
    // Authenticated users need to be able to create/update their usage counters.
    // Admins need to be able to read them for the dashboard.
    match /apiUsageCounters/{docId} {
      allow read: if isAdmin();
      allow write: if isAuthenticated(); // Allows create and update for rate limiting
    }
  }
}
