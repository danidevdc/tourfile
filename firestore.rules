
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin() {
      // Assumes the user's custom claims or a field in their profile marks them as an admin.
      // We will check a 'userProfiles' collection for this.
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // Rules for User Profiles
    match /userProfiles/{userId} {
      // Allow a user to read/write their own profile
      // Allow an admin to read/write any profile
      allow read, write: if request.auth.uid == userId || isAdmin();
      // Allow any authenticated user to create their own profile upon registration
      allow create: if request.auth.uid == userId;
    }
    
    // Rules for generated reports history
    match /generatedReports/{reportId} {
      // Only authenticated users can create reports
      allow create: if request.auth.uid != null;
      // Only admins can read the full list of reports
      allow list, read: if isAdmin();
    }

    // Rules for the AI learning feature
    match /activityTimeSuggestions/{activityName} {
      // Any authenticated user can contribute to the learning data
      // and read the suggestions. This is a deliberate choice for this feature.
      allow read, write: if request.auth.uid != null;
    }

    // Rules for business logic configuration
    match /expenseRules/{ruleId} {
      // Only admins can create, update, or delete business logic rules
      allow write: if isAdmin();
      // Any authenticated user can read the rules to apply them
      allow read: if request.auth.uid != null;
    }

    // Rules for shared data like guides, hotels, etc.
    // We need to allow `list` for authenticated users to populate dropdowns.
    match /guides/{guideId} {
      allow get, list: if request.auth.uid != null;
      allow write: if isAdmin();
    }

    match /hotels/{hotelId} {
      allow get, list: if request.auth.uid != null;
      allow write: if isAdmin();
    }

    match /drivers/{driverId} {
      allow get, list: if request.auth.uid != null;
      allow write: if isAdmin();
    }

    match /activities/{activityId} {
      allow get, list: if request.auth.uid != null;
      allow write: if isAdmin();
    }
  }
}
