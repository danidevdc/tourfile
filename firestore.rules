
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- User Profiles ---
    // Users can create their own profile upon registration.
    // Users can read their own profile and update it. Admins can read/write all profiles.
    match /userProfiles/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true);
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true);
      allow delete: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Data Collections (guides, hotels, activities, drivers) ---
    // Authenticated users can read. Only admins can write/delete.
    match /{collectionId=**}/ {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Generated Reports ---
    // Authenticated users can create reports. Admins can read all.
    match /generatedReports/{reportId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
        allow create: if request.auth != null;
        allow write, delete: if false; // Reports are immutable
    }

    // --- Expense Rules ---
    // Only admins can read and write expense rules.
    match /expenseRules/{ruleId} {
        allow read, write, delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // --- Activity Time Suggestions ---
    // Authenticated users can create/update their own usage stats.
    match /activityTimeSuggestions/{activityId} {
      allow read, write: if request.auth != null;
    }

    // --- API Usage Logs ---
    // Authenticated users can create logs. Admins can read them.
    match /apiUsage/{usageId} {
        allow read: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
        allow create: if request.auth != null;
        allow update, delete: if false; // Logs are immutable
    }
  }
}
