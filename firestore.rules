
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    function isAuth() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    function isOwner(email) {
      return isAuth() && request.auth.token.email == email;
    }
    function isIntermediateUser() {
      return isAuth() && request.auth.token.email == get(/databases/$(database)/documents/appConfig/specialRoles).data.intermediateUserEmail;
    }
    
    // --- User Profiles ---
    // Users can only read/update their own profile. Admins have special access.
    match /userProfiles/{userId} {
      // Any authenticated user can create their own profile during registration.
      allow create: if request.auth != null && request.auth.uid == userId;

      // Users can read their own profile. Admins can read any profile.
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true);

      // Users can update their own profile. Admins can update any profile.
      allow update: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true);

      // Only admins can delete profiles (but not their own).
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true && request.auth.uid != userId;
    }

    // --- Master Data (Guides, Hotels, etc.) ---
    // Anyone logged in can read. Only admins can write.
    match /guides/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    match /hotels/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    match /drivers/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    match /activities/{activityId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    match /flights/{flightId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    match /buses/{busId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    // --- Business Logic Rules ---
    // Anyone logged in can read to generate reports. Only admins can modify them.
    match /expenseRules/{ruleId} {
        allow get, list: if isAuth();
        allow write: if isAdmin();
    }
    
    // --- App Configuration (Special Roles) ---
    // Only admins can write to this document.
    // Any authenticated user can read it to check for special permissions.
    match /appConfig/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    // ADDED THIS BLOCK: Rules for the new Service Order Logic editor
    match /serviceOrderRules/{ruleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isIntermediateUser();
    }
    
    // --- Generated Report Logging (For Admin Panel) ---
    // Any authenticated user can create a report log entry. Only admins can read them.
    match /generatedReports/{reportId} {
      allow create: if isAuth();
      allow read: if isAdmin();
    }
    
    // --- Flight Search Counter ---
    // Any authenticated user can create or update a counter document for flight searches.
    match /flightSearchStats/{day} {
      allow read, write: if isAuth();
    }
    
    // --- Service Orders ---
    // Any authenticated user can read and create orders.
    // Only the owner or an admin can update or delete an order.
    match /serviceOrders/{orderId} {
      allow read, create: if isAuth();
      allow update: if isAuth() && (isOwner(resource.data.createdBy) || isAdmin());
      // Deletion is handled by status change, so update permission is sufficient.
    }

    // --- Learning Data for AI/Suggestions ---
    // Any authenticated user can contribute to the learning data.
    match /activityTimeSuggestions/{activityName} {
      allow read, write: if isAuth();
    }

  }
}
