rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is authenticated.
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the requesting user is an admin.
    // It reads the isAdmin field from the user's own profile document.
    function isAdmin() {
      return isAuthenticated() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // Default deny all reads and writes to prevent accidental access.
    match /{document=**} {
      allow read, write: if false;
    }
    
    // activityTimeSuggestions: Any logged-in user can read and write.
    // This allows the app to learn from user input and provide suggestions.
    match /activityTimeSuggestions/{activityName} {
      allow read, write: if isAuthenticated();
    }
    
    // generatedReports: Logged-in users can create reports. Admins can read all.
    match /generatedReports/{reportId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false; // Reports should be immutable
    }

    // Guides, Hotels, Drivers, Activities: Logged-in users can read. Admins can write.
    // This allows the UI selectors to be populated for all users.
    match /guides/{guideId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /hotels/{hotelId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
    
    // expenseRules: Only admins can read or write.
    // This logic is sensitive and should only be managed by administrators.
    match /expenseRules/{ruleId} {
      allow read, write: if isAdmin();
    }
    
    // userProfiles: Users can read their own profile. Admins can read/write all profiles.
    match /userProfiles/{userId} {
      allow read, update: if request.auth.uid == userId || isAdmin();
      allow create: if isAuthenticated(); // Allow creation on registration.
      allow delete: if isAdmin();
    }
  }
}
