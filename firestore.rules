rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profiles are readable/writable only by the user themselves, or readable by an admin.
    match /userProfiles/{userId} {
      allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      // Admins can read all profiles to display in the admin user list.
      allow list: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // Expense rules are readable by any authenticated user, but only writable by admins.
    match /expenseRules/{ruleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // Generated report summaries are creatable by any authenticated user, but only readable by admins for analytics.
    match /generatedReports/{reportId} {
      allow create: if request.auth != null;
      allow list: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // Fallback security rule for any other path - deny all access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
