rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- User Profiles ---
    // Users can read/update their own profile. Admins can read any profile.
    match /userProfiles/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true);
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == userId;
      // Admins can delete any profile except their own.
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true && request.auth.uid != userId;
    }

    // --- Master Data: Accessible to authenticated users ---
    // Authenticated users can read. Admins can write.
    match /guides/{guideId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    match /hotels/{hotelId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // --- Business Logic & App Data ---
    
    // Expense rules can be read by authenticated users, written by admins.
    match /expenseRules/{ruleId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // Flight data can be read by authenticated users, written by admins.
    match /dailyFlights/{flightId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Generated reports can be created by any authenticated user. Only admins can read all reports.
    match /generatedReports/{reportId} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
      allow create: if request.auth != null;
      allow write: if false; // Users cannot update/delete reports after creation.
    }
    
    // Activity time suggestions can be read and updated by any authenticated user.
    match /activityTimeSuggestions/{activityId} {
        allow read, write: if request.auth != null;
    }
  }
}