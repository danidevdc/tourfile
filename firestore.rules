rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the requesting user is an administrator.
    function isAdmin() {
      // An admin's userProfile document must exist and have the isAdmin flag set to true.
      return exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // Rules for the userProfiles collection
    match /userProfiles/{userId} {
      // A user can create and update their own profile.
      allow create, update: if request.auth != null && request.auth.uid == userId;
      
      // An admin can get any profile. A user can get their own profile.
      allow get: if request.auth != null && (isAdmin() || request.auth.uid == userId);

      // Only admins can list or delete user profiles.
      allow list, delete: if request.auth != null && isAdmin();
    }

    // Rules for the expenseRules collection
    match /expenseRules/{ruleId} {
      // Any authenticated user can read the rules (needed for the generator page to work for everyone).
      allow read: if request.auth != null;

      // Only admins can create, update, or delete the expense rules.
      allow write: if request.auth != null && isAdmin();
    }
  }
}
