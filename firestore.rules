
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      // Check if the user is authenticated and if their profile has the isAdmin flag.
      return isAuth() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    
    function isOwner(email) {
      return isAuth() && request.auth.token.email == email;
    }

    match /userProfiles/{userId} {
      // Any authenticated user can create their own profile.
      allow create: if isAuth() && request.auth.uid == userId;
      // Users can read their own profile. Admins can read any profile.
      allow read: if isAuth() && (request.auth.uid == userId || isAdmin());
      // Users can update their own profile fields. Admins can update any profile.
      allow update: if isAuth() && (request.auth.uid == userId || isAdmin());
      // Only admins can delete user profiles (but not their own).
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /guides/{guideId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();
    }
    match /hotels/{hotelId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();
    }
    match /drivers/{driverId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();
    }
    match /activities/{activityId} {
      allow read: if isAuth();
      allow create, delete: if isAdmin();
      // Admins can update anything. Regular users can only update suggestion fields.
      allow update: if isAuth() && 
        (isAdmin() || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timeCounts', 'suggestedTime'])));
    }
    match /flights/{flightId} {
      allow read, write: if isAuth();
      allow delete: if isAdmin();
    }
    
    // --- Business Logic Rules ---
    match /expenseRules/{ruleId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    match /serviceOrderRules/{ruleId} {
      allow read: if isAuth();
      allow write: if isAdmin() || isOwner(get(/databases/$(database)/documents/appConfig/specialRoles).data.intermediateUserEmail);
    }
    
    // --- App Configuration (Special Roles) ---
    // Only admins can write to this document.
    // Any authenticated user can read it to check for special permissions.
    match /appConfig/{docId} {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    // --- Generated Report Logging ---
    match /generatedReports/{reportId} {
      allow create: if isAuth();
      allow read: if isAdmin();
    }
    
    // --- Flight Search Counter ---
    match /flightSearchStats/{day} {
      allow read, write: if isAuth();
    }
    
    // --- Service Orders ---
    match /serviceOrders/{orderId} {
      allow read, create: if isAuth();
      allow update: if isAuth() && (isOwner(resource.data.createdBy) || isAdmin());
      // Soft delete: only update is needed
      // allow delete: if isAuth() && (isOwner(resource.data.createdBy) || isAdmin());
    }
  }
}

    