rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permite el acceso de lectura y escritura a cualquier usuario autenticado en toda la base de datos.
    // Es una regla adecuada para herramientas internas donde los usuarios son de confianza.
    // Para aplicaciones con datos sensibles, se necesitarían reglas más específicas por colección.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}