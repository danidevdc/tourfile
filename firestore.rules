rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- User Profiles ---
    // Users can read their own profile.
    // They can create it and update their own session ID, but not their admin status or other fields.
    match /userProfiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId &&
                      request.resource.data.keys().hasAll(['activeSessionId', 'lastSignInTime']) ||
                      request.resource.data.keys().hasAll(['generatedReportsCount']);
                      
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // --- App Configuration ---
    // Special roles can only be read and written by an admin.
    match /appConfig/{docId} {
      allow read, write: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Expense Rules (Petty Cash Logic) ---
    // Can only be read and written by an admin.
    match /expenseRules/{ruleId} {
      allow read, write, delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Service Order Rules (Service Order Logic) ---
    // Can be read by any authenticated user, but only written by an admin or the intermediate user.
    match /serviceOrderRules/{ruleId} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && 
                  (get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true ||
                   get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.email == get(/databases/$(database)/documents/appConfig/specialRoles).data.intermediateUserEmail);
    }
    
    // --- Service Orders ---
    // Users can read all orders, but only create/update their own. Admins can do anything.
    match /serviceOrders/{orderId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow update: if request.auth != null && 
                      (resource.data.createdBy == request.auth.token.email || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true);
        // Delete is handled by updating a 'status' field to 'eliminado', so it falls under the 'update' permission.
    }

    // --- Generated Reports (for tracking) & Flight Search Stats ---
    // Any authenticated user can create records. Only admins can read the full list.
    match /generatedReports/{reportId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
     match /flightSearchStats/{statId} {
      allow create, update: if request.auth != null;
      allow read: if request.auth != null;
    }

    // --- Master Data (Guides, Hotels, etc.) ---
    // Anyone authenticated can read, create, and update.
    // Only Admins can delete.
    match /guides/{docId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    match /hotels/{docId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    match /drivers/{docId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    match /activities/{activityId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    match /flights/{flightId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    match /buses/{busId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
