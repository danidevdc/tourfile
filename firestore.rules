rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    // These functions make the rules below easier to read and maintain.
    function isAuth() {
      return request.auth != null;
    }
    function isAdmin() {
      // Check if the user is authenticated and their profile has isAdmin set to true.
      return isAuth() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    function isOwner(email) {
      // Check if the authenticated user's email matches the creator's email stored in a document.
      return isAuth() && request.auth.token.email == email;
    }

    // --- Collections Rules ---

    // Master Data (Guides, Hotels, etc.):
    // Any authenticated user can read. Only admins can write/delete.
    match /{collection}/{docId} 
      where collection in ['guides', 'hotels', 'drivers', 'flights'] {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    
    // Activities have special rules for user updates
    match /activities/{activityId} {
      allow read: if isAuth();
      allow create, delete: if isAdmin();
      // Admins can update anything. Regular users can only update the learning fields.
      allow update: if isAdmin() || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['timeCounts', 'suggestedTime']));
    }

    // Expense Rules: Admins have full control.
    match /expenseRules/{ruleId} {
        allow read, write: if isAdmin();
    }
    
    // Generated Reports (for Admin Panel): 
    // Any authenticated user can create a log. Only admins can read/manage them.
    match /generatedReports/{reportId} {
      allow create: if isAuth();
      allow read, update, delete: if isAdmin();
    }
    
    // Flight Search Counter: Any authenticated user can write to this.
    match /flightSearchStats/{day} {
      allow read, write: if isAuth();
    }
    
    // Service Orders: Any user can read/create. Only owner or admin can modify.
    match /serviceOrders/{orderId} {
      allow read, create: if isAuth();
      allow update, delete: if isAuth() && (isOwner(resource.data.createdBy) || isAdmin());
    }
    
    // Learning Data for AI/Suggestions: Any authenticated user can contribute.
    match /activityTimeSuggestions/{activityName} {
      allow read, write: if isAuth();
    }

    // User Profiles: Users can manage their own profile. Admins can manage any.
    match /userProfiles/{userId} {
      allow read, update: if isAuth() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuth() && request.auth.uid == userId;
      allow delete: if isAdmin() && request.auth.uid != userId;
    }
  }
}
