
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- User Profiles (userProfiles collection) ---
    match /userProfiles/{userId} {
      // READ: 
      // 1. A user can read their own profile.
      // 2. An admin user can read any profile (for user management panels).
      allow read: if request.auth != null && 
                     (request.auth.uid == userId || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true);
                     
      // CREATE: A user can create their own profile document, typically during registration.
      // The UID in the path must match the UID of the logged-in user.
      allow create: if request.auth != null && request.auth.uid == userId;

      // UPDATE: A user can update their own profile.
      allow update: if request.auth != null && request.auth.uid == userId;

      // DELETE:
      // Only an admin can delete a user's profile.
      // A user cannot delete their own profile through this rule to prevent accidental self-deletion.
      allow delete: if request.auth != null &&
                       get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Generated Reports (generatedReports collection) ---
    // Any authenticated user can create (save) a report.
    // Reading is restricted to admins to view analytics.
    match /generatedReports/{reportId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && 
                     get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
      // No update/delete from client for data integrity.
    }

    // --- Business Logic Rules (expenseRules collection) ---
    // Reading is allowed by any authenticated user (needed for the generator).
    // Writing (create, update, delete) is restricted to admins.
    match /expenseRules/{ruleId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && 
                        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // --- Master Data (guides, hotels, drivers, activities) ---
    // Any authenticated user can read this data to populate dropdowns in generators.
    // Writing is restricted to admins via the data management page.
    match /{collectionId}/{docId} 
        where collectionId in ['guides', 'hotels', 'drivers', 'activities', 'activityTimeSuggestions'] {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
                      get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
