
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    
    function getUserData(userId) {
      return get(/databases/$(database)/documents/userProfiles/$(userId)).data;
    }

    function isAdmin() {
      return isAuth() && getUserData(request.auth.uid).isAdmin == true;
    }
    
    // --- User Profiles ---
    match /userProfiles/{userId} {
      allow read: if isAuth() && (isOwner(userId) || isAdmin());
      allow update: if isAuth() && (isOwner(userId) || isAdmin());
      allow create: if isAuth() && isOwner(userId);
      allow delete: if isAdmin(); // Only admins can delete profiles
    }

    // --- Data Collections (guides, hotels, etc.) ---
    // Any authenticated user can read. Only admins can write/delete.
    match /{collection=**} {
      allow read: if isAuth();
    }
    
    match /guides/{guideId} {
      allow write, delete: if isAdmin();
    }
    match /hotels/{hotelId} {
      allow write, delete: if isAdmin();
    }
    match /activities/{activityId} {
      allow write, delete: if isAdmin();
    }
    match /drivers/{driverId} {
      allow write, delete: if isAdmin();
    }
    match /flights/{flightId} {
      allow write, delete: if isAdmin();
    }
    match /flightSearchStats/{statId} {
       allow write, read: if isAuth();
    }
    match /expenseRules/{ruleId} {
       allow read: if isAuth();
       allow write, delete: if isAdmin();
    }
     match /generatedReports/{reportId} {
      allow read: if isAuth();
      allow create: if isAuth();
    }

    // --- Service Orders ---
    match /serviceOrders/{orderId} {
      // ANY authenticated user can read any service order.
      // The app logic will filter what is shown (e.g., hide "deleted" status for non-admins).
      allow read: if isAuth();
      
      // ANY authenticated user can create an order.
      allow create: if isAuth();
      
      // Users can only update/delete orders they created, or admins can update/delete any.
      allow update: if isAuth() && (isAdmin() || request.auth.uid == resource.data.createdBy);
      allow delete: if isAuth() && (isAdmin() || request.auth.uid == resource.data.createdBy);
    }
  }
}
