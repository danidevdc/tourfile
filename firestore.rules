rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuth() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    function isAdmin() {
      // Assumes user's admin status is stored in a 'userProfiles' collection
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- User Profiles ---
    match /userProfiles/{userId} {
      // Admins can read any profile. Users can only read their own.
      allow read: if isAuth() && (isOwner(userId) || isAdmin());
      // Users can create their own profile.
      allow create: if isAuth() && isOwner(userId);
      // Users can only update their own profile. Admins can update any.
      allow update: if isAuth() && (isOwner(userId) || isAdmin());
      // Only admins can delete user profiles.
      allow delete: if isAuth() && isAdmin();
    }
    
    // --- Service Orders ---
    match /serviceOrders/{orderId} {
      // Any authenticated user can read any service order.
      allow read: if isAuth();
      // Any authenticated user can create a service order.
      allow create: if isAuth();
      // Only the owner or an admin can update or delete a service order.
      allow update, delete: if isAuth() && (isOwner(resource.data.createdBy) || isAdmin());
    }

    // --- Master Data Collections (Guides, Hotels, Drivers, Activities, Flights) ---
    // These collections are managed by admins, but readable by all authenticated users.
    match /{collectionName}/{docId} 
        where collectionName in ['guides', 'hotels', 'drivers', 'activities', 'flights', 'expenseRules', 'flightSearchStats', 'generatedReports'] {
      // Any authenticated user can read the master data
      allow read: if isAuth();
      // Only admins can create, update, or delete master data
      allow write: if isAuth() && isAdmin();
    }
  }
}
