rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- User Profiles ---
    // Users can read/update their own profile. Admins can read/delete all.
    match /userProfiles/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || request.auth.token.isAdmin == true);
      allow create: if request.auth != null;
      allow update: if request.auth.uid == userId;
      allow delete: if request.auth.token.isAdmin == true;
    }
    
    // --- Data Management (Guides, Hotels, Drivers, Activities, Rules) ---
    // Any authenticated user can read this data. Only admins can write/delete.
    match /{collection}/{docId} 
        where collection in ['guides', 'hotels', 'drivers', 'activities', 'expenseRules', 'activityTimeSuggestions'] {
          allow read: if request.auth != null;
          allow write, delete: if request.auth.token.isAdmin == true;
    }

    // --- API Usage Tracking ---
    // Authenticated users can create usage logs. Admins can read them.
    match /apiUsage/{logId} {
      allow create: if request.auth != null;
      allow read: if request.auth.token.isAdmin == true;
    }

    // --- Generated Reports History ---
    // Authenticated users can create report logs. Admins can read them.
    match /generatedReports/{reportId} {
        allow create: if request.auth != null;
        allow read: if request.auth.token.isAdmin == true;
    }

    // --- Default Deny All Other Access ---
    // It's a good practice to explicitly deny access to any other collections
    // not covered by the rules above. However, the default is to deny,
    // so this is implicitly handled.
  }
}