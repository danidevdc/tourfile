rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check for admin role
    function isAdmin() {
      return exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // User Profiles: Users can read/update their own profile. Admins can read any.
    match /userProfiles/{userId} {
      allow read: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId;
      allow delete: if isAdmin(); // Only admins can delete
    }

    // Guides, Hotels, Activities, Drivers: Authenticated users can read. Admins can write.
    match /guides/{guideId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    match /hotels/{hotelId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
     match /activities/{activityId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
     match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Expense Rules: Authenticated users can read. Admins can write.
    match /expenseRules/{ruleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Generated Reports: Authenticated users can create. Admins can read all.
    match /generatedReports/{reportId} {
      allow create: if request.auth != null;
      allow read: if isAdmin();
      allow write: if false; // Disallow update/delete for now
    }
    
    // API Usage: Any authenticated user can create a log entry. Admins can read.
    match /apiUsage/{usageId} {
        allow create: if request.auth != null;
        allow read: if isAdmin();
        allow update, delete: if false; // Logs are immutable
    }

    // Activity Time Suggestions: Authenticated users can create and update.
    match /activityTimeSuggestions/{activityId} {
      allow read, write: if request.auth != null;
    }
  }
}
