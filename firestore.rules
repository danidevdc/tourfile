rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuth() {
      return request.auth != null;
    }
    function isAdmin() {
      // Check if the user is authenticated and if their profile has isAdmin set to true.
      return isAuth() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    function isOwner(email) {
      // Check if the authenticated user's email matches the creator's email.
      return isAuth() && request.auth.token.email == email;
    }

    // --- Collections Rules ---

    // Guides, Hotels, Drivers, Activities, Flights: Any authenticated user can read. Only admins can write/delete.
    match /{collection}/{docId} 
      where collection in ['guides', 'hotels', 'drivers', 'activities', 'flights'] {
      allow read: if isAuth();
      allow write: if isAdmin();
    }

    // Expense Rules: Only admins can read or write.
    match /expenseRules/{ruleId} {
        allow read, write: if isAdmin();
    }
    
    // Flight Search Stats & Generated Reports: Any authenticated user can read. Any authenticated user can create. Admins can do anything.
     match /{collection}/{docId} 
      where collection in ['flightSearchStats', 'generatedReports'] {
      allow read, create: if isAuth();
      allow update, delete: if isAdmin();
    }

    // --- Service Orders ---
    // Any authenticated user can read, create, and update orders.
    // Only the owner or an admin can delete an order.
    match /serviceOrders/{orderId} {
      allow read, create, update: if isAuth();
      allow delete: if isAuth() && (isOwner(resource.data.createdBy) || isAdmin());
    }

    // --- User Profiles ---
    // Users can read their own profile. Admins can read any profile.
    // Users can create their own profile document.
    // Users can update their own profile. Admins can update any profile.
    // Only admins can delete profiles (but not their own).
    match /userProfiles/{userId} {
      allow read: if isOwner(resource.data.email) || isAdmin();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isOwner(resource.data.email) || isAdmin();
      allow delete: if isAdmin() && request.auth.uid != userId;
    }
  }
}
