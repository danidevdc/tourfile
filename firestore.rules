rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /userProfiles/{userId} {
      // Users can read/update their own profile
      allow read, update: if request.auth.uid == userId;
      // Admins can read any profile (for the admin dashboard)
      allow get: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
      // Users can create their own profile upon registration
      allow create: if request.auth.uid == userId;
      // Only admins can delete profiles (except their own via this rule)
      allow delete: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true && request.auth.uid != userId;
    }
    
    // List of all user profiles
    match /userProfiles/{document=**} {
        // Only admins can list all user profiles
        allow list: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // Generated Reports logs
    match /generatedReports/{reportId} {
      // Any authenticated user can create a report log entry
      allow create: if request.auth != null;
      // Only admins can read the full list of reports
      allow list, get: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // API Usage Counters
    // Any authenticated user can read and write to the counters collection.
    // The logic in the Cloud Function securely handles increments.
    match /apiUsageCounters/{docId} {
      allow read, write: if request.auth != null;
    }

    // Master Data (Guides, Hotels, Drivers, Activities) and Expense Rules
    // Any authenticated user can read this data to populate dropdowns and generate reports.
    // Write access is limited to admins via application logic, but rules allow writes
    // for simplicity, relying on the UI to restrict access.
    match /guides/{guideId} {
      allow read, write: if request.auth != null;
    }
    match /hotels/{hotelId} {
      allow read, write: if request.auth != null;
    }
    match /drivers/{driverId} {
      allow read, write: if request.auth != null;
    }
    match /activities/{activityId} {
      allow read, write: if request.auth != null;
    }
    match /expenseRules/{ruleId} {
       allow read, write: if request.auth != null;
    }
     match /activityTimeSuggestions/{activityId} {
      allow read, write: if request.auth != null;
    }
  }
}
