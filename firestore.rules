
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write access to the entire database for any authenticated user.
    // This is a common starting point for development. For production, you should
    // implement more granular rules to secure your data.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
