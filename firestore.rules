
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isUserAdmin(userId) {
      return get(/databases/$(database)/documents/userProfiles/$(userId)).data.isAdmin == true;
    }

    // Rules for user profiles
    match /userProfiles/{userId} {
      // Admins can read and write any profile
      // Users can only read their own profile
      allow read, write: if isUserAdmin(request.auth.uid);
      allow read: if request.auth.uid == userId;
    }
    
    // Rules for generated reports metadata
    match /generatedReports/{reportId} {
      // Any authenticated user can create a report record
      allow create: if request.auth != null;
      // Only admins can read all reports
      allow read, list: if isUserAdmin(request.auth.uid);
    }
    
    // Rules for flight search statistics
    match /flightSearchStats/{date} {
      // Allow any authenticated user to read stats (for the chart)
      allow get: if request.auth != null;
      // Allow any authenticated user to create/update their own search count
      allow write: if request.auth != null;
    }

    // Rules for master data (guides, hotels, etc.)
    match /{collection}/{docId} where collection in ['guides', 'hotels', 'drivers', 'activities', 'flights'] {
      // Any authenticated user can read the master data
      allow read: if request.auth != null;
      // Only admins can write to the master data
      allow write: if isUserAdmin(request.auth.uid);
    }

    // Rules for expense rules logic
    match /expenseRules/{ruleId} {
        // Any authenticated user can read the rules to generate reports
        allow read: if request.auth != null;
        // Only admins can modify the rules
        allow write: if isUserAdmin(request.auth.uid);
    }
    
    // Rules for service order rules logic
    match /serviceOrderRules/{ruleId} {
        // Any authenticated user can read the rules to generate orders
        allow read: if request.auth != null;
        // Only admins can modify the rules
        allow write: if isUserAdmin(request.auth.uid);
    }

    // Rules for service orders
    match /serviceOrders/{orderId} {
      // Users can create orders
      allow create: if request.auth != null;
      // Users can read/update/delete their own orders. Admins can manage any order.
      allow read, update, delete: if isUserAdmin(request.auth.uid) || resource.data.createdBy == request.auth.token.email;
      // Admins can list all orders, but users cannot (for security/privacy)
      allow list: if isUserAdmin(request.auth.uid);
    }
  }
}
