
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // --- User Profiles ---
    // Users can read and update their own profile.
    match /userProfiles/{userId} {
      allow read, update: if request.auth.uid == userId;
      // Admins can do anything with user profiles
      allow read, write: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // --- Data Management (For Admin Panel) ---
    // Any authenticated user can read this data for the generators.
    match /guides/{guideId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    match /hotels/{hotelId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Rule Management (For Admin Panel) ---
    // Only admins can read and write expense rules.
    match /expenseRules/{ruleId} {
      allow read, write: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // --- Generated Report Logging (For Admin Panel) ---
    // Any authenticated user can create a report log entry. Only admins can read them.
    match /generatedReports/{reportId} {
      allow create: if request.auth != null;
      allow read: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Activity Time Suggestions (For Service Order AI) ---
    // Any authenticated user can write to this collection to improve suggestions.
    match /activityTimeSuggestions/{activityName} {
        allow read, write: if request.auth != null;
    }
    
    // --- Flight Search Counter ---
    // Any authenticated user can create or update a counter document for flight searches.
    match /flightSearchStats/{day} {
      allow read, write: if request.auth != null;
    }

  }
}
