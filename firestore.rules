rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper Functions
    function isAuth() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // Collection Rules

    match /userProfiles/{userId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.email == request.auth.token.email;
      allow update: if isAuth() && (isOwner(userId) || isAdmin());
      allow delete: if isAuth() && isAdmin(); // Only admins can delete profiles
    }

    match /expenseRules/{ruleId} {
      allow read: if isAuth();
      allow write: if isAuth() && isAdmin(); // Only admins can create, update, delete rules
    }
    
    match /generatedReports/{reportId} {
      allow read: if isAuth();
      allow create: if isAuth();
    }
    
    match /flightSearchStats/{statId} {
      allow read: if isAuth();
      // Allow any authenticated user to trigger an update via transaction
      allow write: if isAuth(); 
    }

    match /serviceOrders/{orderId} {
      // Allow any authenticated user to read all service orders.
      // The app's UI logic will filter out 'eliminado' status for non-admins.
      allow read: if isAuth();
      // Allow any authenticated user to create.
      allow create: if isAuth(); 
      // Only allow owner or admin to update/delete (soft delete).
      allow update: if isAuth() && (isOwner(resource.data.createdBy) || isAdmin());
      allow delete: if isAuth() && (isOwner(resource.data.createdBy) || isAdmin());
    }
    
    // Generic collections for master data
    match /{collection}/{docId} {
        // Any authenticated user can read master data (guides, hotels, etc.)
        allow read: if isAuth();
        // Only admins can modify master data
        allow write: if isAuth() && isAdmin();
    }
  }
}
