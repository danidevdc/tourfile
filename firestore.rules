rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isAuth() {
      return request.auth != null;
    }
    function isAdmin() {
      return isAuth() && (
        request.auth.token.isAdmin == true || // JWT token (0 lecturas)
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true // Fallback
      );
    }
    function isOwner(email) {
      return isAuth() && request.auth.token.email == email;
    }
    function isIntermediateUser() {
      return isAuth() && (
        request.auth.token.email == get(/databases/$(database)/documents/appConfig/specialRoles).data.intermediateUserEmail ||
        request.auth.token.email in get(/databases/$(database)/documents/appConfig/specialRoles).data.allowedEditors
      );
    }

    // --- User Profiles ---
    // Users can only read/update their own profile. Admins have special access.
    match /userProfiles/{userId} {
      // Any authenticated user can create their own profile during registration.
      allow create: if request.auth != null && request.auth.uid == userId;

      // Users can read their own profile. Admins can read any profile.
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true);

      // Users can update their own profile. Admins can update any profile.
      allow update: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true);

      // Only admins can delete profiles (but not their own).
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true && request.auth.uid != userId;
    }

    // --- Master Data (Guides, Hotels, etc.) ---
    // Anyone logged in can read/write/update/delete.
    match /guides/{docId} {
      allow read, write, update, delete: if isAuth();
    }
    match /hotels/{docId} {
      allow read, write, update, delete: if isAuth();
    }
    match /drivers/{docId} {
      allow read, write, update, delete: if isAuth();
    }
    match /activities/{activityId} {
      allow read, write, update, delete: if isAuth();
    }
    match /flights/{flightId} {
      allow read, write, update, delete: if isAuth();
    }
    match /buses/{busId} {
      allow read, write, update, delete: if isAuth();
    }

    // --- Business Logic Rules ---
    // Anyone logged in can read to generate reports. Only admins can modify them.
    match /expenseRules/{ruleId} {
        allow get, list: if isAuth(); // This rule allows any authenticated user to read the list of rules.
        allow write: if isAdmin();
    }

    // --- App Configuration (Special Roles) ---
    // Only admins can write to this document.
    // Any authenticated user can read it to check for special permissions.
    match /appConfig/healthCheck {
      allow read: if true;
    }
    match /appConfig/specialRoles {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    match /appConfig/flightSearchSettings {
      allow read: if isAuth();
      allow write: if isAdmin();
    }
    match /appConfig/{docId} {
      allow read: if isAuth();
      allow write: if isAuth() && (docId == 'masterDataVersion' || isAdmin());
    }

    // ADDED THIS BLOCK: Rules for the new Service Order Logic editor
    match /serviceOrderRules/{ruleId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || isIntermediateUser();
    }

    // --- Generated Report Logging (For Admin Panel) ---
    // Any authenticated user can create a report log entry. Only admins can read them.
    match /generatedReports/{reportId} {
      allow create: if request.auth != null;
      allow read: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Flight Search Counter ---
    // Any authenticated user can create or update a counter document for flight searches.
    match /flightSearchStats/{day} {
      allow read, write: if request.auth != null;
    }

    // --- Flight Route Cache ---
    // Stores route discovery like BOV304 -> LPB/UYU for the Google Flights hybrid provider.
    match /flightRouteCache/{flightNumber} {
      allow read, write: if isAuth();
    }

    // --- Service Orders ---
    // Any authenticated user can read and create orders.
    // Update: owner, admin, intermediate, OR any auth user updating only the hasLiquidation flag.
    // Delete: owner, admin, or intermediate only.
    match /serviceOrders/{orderId} {
      allow read, create: if isAuth();
      allow update: if isAuth() && (
        isOwner(resource.data.createdBy) || isAdmin() || isIntermediateUser() ||
        // Allow any authenticated user to set hasLiquidation flag (set by saveLiquidation)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasLiquidation'])
      );
      allow delete: if isAuth() && (isOwner(resource.data.createdBy) || isAdmin() || isIntermediateUser());
    }

    // --- Guide Liquidations ---
    // Any authenticated user can read, create, and delete liquidations.
    // Update allowed to any auth user (edit items/amounts) — not just admin.
    match /guideLiquidations/{liquidationId} {
      allow read, create, delete: if isAuth();
      allow update: if isAuth();
    }

    // --- Guide Liquidation Criteria (price rules) ---
    // Any authenticated user can read and write (module still in development).
    match /guideLiquidationCriteria/{ruleId} {
      allow read, write: if isAuth();
    }

    // --- Guide Month Cache (precomputed rows per guide+month for past months) ---
    // Any authenticated user can read and write — cache is non-sensitive derived data.
    match /guideMonthCache/{cacheId} {
      allow read, write: if isAuth();
    }

    // --- Guide Language Memory (learning system) ---
    // Any authenticated user can read and write (auto-learning on save).
    match /guideLiquidationGuideLanguage/{guideId} {
      allow read, write: if isAuth();
    }

    // --- Learning Data for AI/Suggestions ---
    // Any authenticated user can contribute to the learning data.
    match /activityTimeSuggestions/{activityName} {
      allow read, write: if isAuth();
    }

  }
}
