
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Default deny all access unless explicitly allowed by rules below
    match /{document=**} {
      allow read, write: if false;
    }

    // USER PROFILES
    // Users can read their own profile.
    // Users can create their own profile upon registration.
    // Admins can read/write any profile.
    match /userProfiles/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true);
      allow create: if request.auth != null;
      allow update: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true);
      allow delete: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // ADMIN-ONLY WRITE COLLECTIONS
    // Only admins can write (create, update, delete) to these collections.
    // Any authenticated user can read them.
    match /guides/{guideId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    match /hotels/{hotelId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    match /activities/{activityId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    
    match /drivers/{driverId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    match /expenseRules/{ruleId} {
      allow read: if request.auth != null;
      allow write: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    
    match /activityTimeSuggestions/{activityId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // Any authenticated user can contribute to suggestions
    }

    // FLIGHTS COLLECTION
    // Any authenticated user can read.
    // Only admins can write/delete.
    match /dailyFlights/{flightId} {
        allow read: if request.auth != null;
        allow write: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // REPORTS COLLECTION
    // Users can create reports.
    // Admins can read all reports.
    match /generatedReports/{reportId} {
        allow create: if request.auth != null;
        allow read: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
        // No update/delete from client for now
        allow update, delete: if false; 
    }
  }
}
