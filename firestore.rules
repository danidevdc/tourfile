
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin.
    // An admin is someone whose profile has `isAdmin: true`.
    function isUserAdmin(userId) {
      // Check for the existence of the user's profile document first to prevent errors.
      return exists(/databases/$(database)/documents/userProfiles/$(userId)) &&
             get(/databases/$(database)/documents/userProfiles/$(userId)).data.isAdmin == true;
    }

    // Rules for User Profiles
    match /userProfiles/{userId} {
      // Allow read access to admins or the user themselves.
      allow get: if request.auth != null && (isUserAdmin(request.auth.uid) || request.auth.uid == userId);
      // Allow list access only to admins.
      allow list: if request.auth != null && isUserAdmin(request.auth.uid);
      // Allow users to create their own profile upon registration.
      allow create: if request.auth != null && request.auth.uid == userId;
      // Allow users to update their own profile, or admins to update any profile.
      allow update: if request.auth != null && (isUserAdmin(request.auth.uid) || request.auth.uid == userId);
      // Allow admins to delete profiles, but not their own via this rule.
      allow delete: if request.auth != null && isUserAdmin(request.auth.uid) && request.auth.uid != userId;
    }

    // Rules for Expense Logic Rules
    match /expenseRules/{ruleId} {
      // Any authenticated user can read the rules to generate reports.
      allow read: if request.auth != null;
      // Only admins can create, update, or delete the expense rules.
      allow write: if request.auth != null && isUserAdmin(request.auth.uid);
    }
  }
}
