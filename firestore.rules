rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get user profile data
    function getUserProfile(uid) {
      return get(/databases/$(database)/documents/userProfiles/$(uid)).data;
    }

    // Helper function to check if the requesting user is an admin
    function isRequestingUserAdmin() {
      return isAuthenticated() && getUserProfile(request.auth.uid).isAdmin == true;
    }

    // --- User Profiles ---
    // Allow users to read their own profile.
    // Allow any authenticated user to create their own profile during registration.
    // Allow admins to read any profile and update/delete profiles.
    match /userProfiles/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isRequestingUserAdmin());
      allow create: if isAuthenticated(); // Registration creates the profile
      allow update, delete: if isRequestingUserAdmin();
    }
    
    // --- Generated Reports Log ---
    // Any authenticated user can create a report log entry.
    // Only admins can read all report logs.
    match /generatedReports/{reportId} {
      allow create: if isAuthenticated();
      allow read: if isRequestingUserAdmin();
      allow list, update, delete: if isRequestingUserAdmin();
    }

    // --- API Usage Counters ---
    // Any authenticated user can read and write to the counters collection.
    // The server-side logic handles the incrementing, so this is safe.
    match /apiUsageCounters/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    // --- Master Data Collections (guides, hotels, etc.) ---
    // Only admins can read, create, update, or delete these records.
    match /{collectionName}/{docId} where collectionName in ['guides', 'hotels', 'drivers', 'activities', 'expenseRules', 'activityTimeSuggestions'] {
      allow read, write, create, delete: if isRequestingUserAdmin();
    }
    
    // Default deny all other reads/writes
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
