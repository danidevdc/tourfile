rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- User Profiles ---
    match /userProfiles/{userId} {
      // Allow users to read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to create their own profile upon registration
      allow create: if request.auth != null && request.auth.uid == userId;

      // Allow users to update their own lastSignInTime and activeSessionId
      allow update: if request.auth != null && request.auth.uid == userId &&
                       request.resource.data.keys().hasOnly(['lastSignInTime', 'activeSessionId', 'generatedReportsCount']);

      // Disallow direct deletion by users from the client
      allow delete: if false; 
    }
    
    // --- Admin access to User Profiles ---
    match /userProfiles/{userId} {
        // Admins can read/write any user profile
        allow read, write: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }


    // --- Generated Reports (for tracking) ---
    match /generatedReports/{reportId} {
      // Only authenticated users can create (save) a report log
      allow create: if request.auth != null;
      // Admins can read all reports for analytics
      allow read: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
      // Nobody can update or delete report logs from the client to preserve history
      allow update, delete: if false;
    }

    // --- API Usage Counters ---
    match /apiUsageCounters/{docId} {
      // Any authenticated user can read and write to the counters.
      // The logic in the backend function is what safely increments the counters.
      allow read, write: if request.auth != null;
    }

    // --- Expense Rules (for Petty Cash Logic) ---
    match /expenseRules/{ruleId} {
        // Any authenticated user can read the rules to generate reports
        allow read: if request.auth != null;
        // Only admins can create, update, or delete rules
        allow write: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Master Data Collections (Guides, Hotels, Drivers, Activities) ---
    match /{collectionName}/{docId} where collectionName in ['guides', 'hotels', 'drivers', 'activities', 'activityTimeSuggestions'] {
        // Any authenticated user can read the master data
        allow read: if request.auth != null;
        // Only admins can write (create, update, delete) to the master data
        allow write: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
