rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- User Profiles ---
    // Users can read their own profile.
    // Users can create their own profile upon registration.
    // Users can only update their own lastSignInTime and activeSessionId.
    // Admins can read/write any profile. Deletion is restricted.
    match /userProfiles/{userId} {
      allow read: if request.auth.uid == userId || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
      allow create: if request.auth.uid == userId;
      allow update: if request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSignInTime', 'activeSessionId', 'generatedReportsCount'])
                    || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
      allow delete: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // --- Generated Reports ---
    // Users can create their own reports.
    // Users can read their own reports. Admins can read all.
    match /generatedReports/{reportId} {
        allow create: if request.auth != null;
        allow read: if request.auth.uid == resource.data.generatedBy || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
        allow update, delete: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Service Orders ---
    // Users can create/read their own service orders.
    // Admins can read/write/delete any service order.
    match /serviceOrders/{orderId} {
        allow create: if request.auth != null && request.resource.data.createdBy == request.auth.token.email;
        allow read, update: if request.auth != null && (resource.data.createdBy == request.auth.token.email || get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true);
        allow delete: if get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Master Data (Guides, Hotels, etc.) ---
    // Anyone logged in can read, create, and update. Only admins can delete.
    match /guides/{docId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    match /hotels/{docId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    match /drivers/{docId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    match /activities/{activityId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    match /flights/{flightId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
    match /buses/{busId} {
      allow read, create, update: if request.auth != null;
      allow delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Rule Definitions (Expense & Service Order) & App Config ---
    // Read access for any authenticated user is required for the client-side logic.
    // Write access should be restricted to admins or designated intermediate roles.
    match /expenseRules/{ruleId} {
        allow read: if request.auth != null;
        allow write, delete: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
     match /serviceOrderRules/{ruleId} {
        allow read: if request.auth != null;
        allow write, delete: if request.auth != null && (get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true || get(/databases/$(database)/documents/appConfig/specialRoles).data.intermediateUserEmail == request.auth.token.email);
    }
     match /appConfig/{configId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }
     match /flightSearchStats/{statId} {
        allow read, write: if request.auth != null;
     }
  }
}
