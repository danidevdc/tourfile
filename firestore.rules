
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      // Check if the requesting user's profile has isAdmin set to true.
      // Make sure this path is correct and the document exists for admin users.
      return get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true;
    }

    // --- Default Security Rule ---
    // By default, deny all reads and writes.
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Collection-Specific Rules ---

    // USER PROFILES
    match /userProfiles/{userId} {
      // Allow a user to create their own profile upon registration.
      allow create: if request.auth.uid == userId;
      // Allow a user to read and update ONLY their own profile.
      allow read, update: if isOwner(userId);
      // Allow ONLY admins to delete user profiles (except their own via this rule).
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // MASTER DATA (Guides, Hotels, Drivers, Activities)
    match /{collectionName}/{docId} where collectionName in ['guides', 'hotels', 'drivers', 'activities'] {
      // Allow any authenticated user to read master data (needed for dropdowns etc.).
      allow read: if request.auth != null;
      // Allow ONLY admins to create, update, or delete master data.
      allow write: if isAdmin();
    }

    // BUSINESS LOGIC (Expense Rules)
    match /expenseRules/{ruleId} {
      // Allow any authenticated user to read the rules (needed for generation).
      allow read: if request.auth != null;
      // Allow ONLY admins to create, update, or delete rules.
      allow write: if isAdmin();
    }
    
    // USAGE STATS (Counters for flights and reports)
    match /{collectionName}/{statId} where collectionName in ['flightSearchStats', 'generatedReports'] {
      // Allow admins to READ the stats for the dashboard.
      allow read: if isAdmin();
      // Allow any authenticated user to CREATE and UPDATE their stats.
      allow create, update: if request.auth != null;
      // No one can delete stats documents through the app.
      allow delete: if false;
    }
  }
}
